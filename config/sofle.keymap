#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "keys_se.h"
#include "keys_sv.h"

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3
#define extra_layer 4

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        emacs_one_shot {
            bindings = <&sl 4>;
            key-positions = <53 56>;
        };
    };

    behaviors {
        caps: caps {
            compatible = "zmk,behavior-caps-word";
            label = "CAPS";
            #binding-cells = <0>;
            continue-list = <POUND MINUS BACKSPACE UNDERSCORE>;
        };
    };

    macros {
        emacs_string_replace: emacs_replace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SV_X) &kp SV_R &kp SV_S>, <&macro_tap>;

            label = "EMACS_REPLACE";
        };

        emacs_fuzzy_find: emacs_fuzzy_find {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SV_X) &kp SV_F>, <&macro_tap>;

            label = "EMACS_FUZZY_FIND";
        };

        emacs_dired: emacs_dired {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SV_X) &kp LC(SV_F)>, <&macro_tap>;

            label = "EMACS_DIRED";
        };

        emacs_treemacs: emacs_treemacs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SV_X) &kp SV_T>, <&macro_tap>;

            label = "EMACS_TREEMACS";
        };

        emacs_follow_symbol: emacs_follow_symbol {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SV_X) &kp SV_R &kp SV_R>, <&macro_press>;

            label = "EMACS_FOLLOW_SYMBOL";
        };

        emacs_backup_from_symbol: emacs_backup_from_symbol {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SV_X) &kp SV_R &kp SV_H>, <&macro_tap>;

            label = "EMACS_BACKUP_FROM_SYMBOL";
        };

        emacs_find_references: emacs_find_references {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SV_X) &kp SV_R &kp SV_F>, <&macro_tap>;

            label = "EMACS_FIND_REFERENCES";
        };

        emacs_goto_line: emacs_goto_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SV_X) &kp SV_R &kp SV_L>, <&macro_tap>;

            label = "EMACS_GOTO_LINE";
        };

        emacs_switch_buffer: emacs_switch_buffer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SV_X) &kp SV_B>, <&macro_tap>;

            label = "EMACS_SWITCH_BUFFER";
        };

        emacs_kill_buffer: emacs_kill_buffer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SV_X) &kp SV_K>, <&macro_tap>;

            label = "EMACS_KILL_BUFFER";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Home {
            display-name = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESCAPE        &kp N1  &kp N2  &kp N3        &kp N4        &kp N5                                             &kp N6  &kp N7    &kp N8    &kp N9  &kp N0           &trans
&kp TAB           &kp Q   &kp W   &kp E         &kp R         &kp T                                              &kp Y   &kp U     &kp I     &kp O   &kp P            &kp SV_A_RING
&kp LEFT_SHIFT    &kp A   &kp S   &kp D         &kp F         &kp G                                              &kp H   &kp J     &kp K     &kp L   &kp SV_O_UMLAUT  &kp SV_A_UMLAUT
&kp LEFT_CONTROL  &kp Z   &kp X   &kp C         &kp V         &kp B   &kp LC(LEFT_ARROW)    &kp LC(RIGHT_ARROW)  &kp N   &kp M     &trans    &trans  &trans           &trans
                          &trans  &kp LEFT_WIN  &kp LEFT_ALT  &mo 1   &kp SPACE             &kp ENTER            &mo 2   &kp RALT  &kp RGUI  &trans
            >;

            label = "home";
        };

        Lower {
            display-name = "lower";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp ESCAPE        &kp F1          &kp F2  &kp F3        &kp F4                   &kp F5                                      &kp F6             &kp F7              &kp F8            &kp F9               &kp F10  &kp F11
&kp TAB           &kp SV_SECTION  &trans  &kp SV_ACUTE  &kp SV_LEFT_PARENTHESIS  &kp SV_RIGHT_PARENTHESIS                    &kp SV_LEFT_BRACE  &kp SV_RIGHT_BRACE  &kp SV_BACKSLASH  &kp SV_CARET         &trans   &kp F12
&kp LEFT_SHIFT    &trans          &trans  &kp SV_TILDE  &kp SV_LESS_THAN         &kp SV_GREATER_THAN                         &kp SV_COMMA       &kp SV_DOT          &kp SV_MINUS      &kp SV_SINGLE_QUOTE  &trans   &trans
&kp LEFT_CONTROL  &trans          &trans  &kp SV_PIPE   &kp SV_LEFT_BRACKET      &kp SV_RIGHT_BRACKET      &trans    &trans  &kp SV_EQUAL       &kp SV_PLUS         &trans            &trans               &trans   &trans
                                  &trans  &kp LEFT_GUI  &kp LEFT_ALT             &trans                    &trans    &trans  &sl 4              &kp RIGHT_ALT       &kp RIGHT_GUI     &trans
            >;

            label = "Lower";
        };

        Raise {
            display-name = "raise";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&kp ESCAPE        &trans  &trans      &trans        &trans        &trans                             &kp PRINTSCREEN  &trans         &trans         &trans     &trans  &to 3
&kp TAB           &trans  &kp INSERT  &trans        &trans        &trans                             &trans           &trans         &kp UP         &trans     &trans  &trans
&kp LEFT_SHIFT    &trans  &kp DELETE  &trans        &trans        &kp CAPSLOCK                       &kp BACKSPACE    &kp LEFT       &kp DOWN       &kp RIGHT  &trans  &trans
&kp LEFT_CONTROL  &trans  &trans      &trans        &trans        &trans        &kp HOME    &kp END  &trans           &trans         &trans         &trans     &trans  &trans
                          &trans      &kp LEFT_WIN  &kp LEFT_ALT  &sl 4         &trans      &trans   &trans           &kp RIGHT_ALT  &kp RIGHT_GUI  &trans
            >;

            label = "Raise";
        };

        System {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "system";
            bindings = <
&to 0  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                           &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none         &none                                  &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none         &none                                  &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none         &bt BT_CLR    &bt BT_CLR_ALL    &none  &none  &none  &none  &none  &none  &none
                     &none         &none         &none         &none         &none             &none  &none  &none  &none  &none
            >;

            label = "system";
        };

        emacs {
            bindings = <
&trans  &trans  &trans                 &trans        &trans                  &trans                                                                   &trans  &trans  &trans              &trans            &trans  &trans
&trans  &trans  &trans                 &trans        &emacs_find_references  &emacs_treemacs                                                          &trans  &trans  &trans              &trans            &trans  &trans
&trans  &trans  &emacs_string_replace  &emacs_dired  &emacs_fuzzy_find       &trans                                                                   &trans  &trans  &emacs_kill_buffer  &emacs_goto_line  &trans  &trans
&trans  &trans  &trans                 &trans        &trans                  &emacs_switch_buffer  &emacs_follow_symbol    &emacs_backup_from_symbol  &trans  &trans  &trans              &trans            &trans  &trans
                &trans                 &trans        &trans                  &trans                &trans                  &trans                     &trans  &trans  &trans              &trans
            >;

            label = "emacs";
        };
    };
};
